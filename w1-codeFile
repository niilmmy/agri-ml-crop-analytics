"""
Week 1 starter code: cleaning + EDA for two agricultural datasets.
  A) Crop Production in India  -> columns: State_Name, District_Name, Crop_Year, Season, Crop, Area, Production
  B) Crop Recommendation       -> columns: N, P, K, temperature, humidity, ph, rainfall, label

Install:  pip install pandas numpy scipy scikit-learn matplotlib seaborn pymannkendall   (pymannkendall is optional)
Run:      python agri_week1_eda.py
Put the raw CSVs in data/raw/ (names below) and edit the paths if yours differ.
"""
import os
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler

RAW_A = "data/raw/crop_production.csv"
RAW_B = "data/raw/Crop_recommendation.csv"
OUT_DIR = "data/processed"
FIG_DIR = "reports/figures"
SEED = 42
np.random.seed(SEED)
sns.set_theme(style="whitegrid")
for d in (OUT_DIR, FIG_DIR):
    os.makedirs(d, exist_ok=True)


def bh_adjust(p):
    """Benjamini-Hochberg adjusted p-values."""
    p = np.asarray(p, float)
    order = np.argsort(p)
    ranked = p[order] * len(p) / (np.arange(len(p)) + 1)
    adj = np.minimum.accumulate(ranked[::-1])[::-1]
    out = np.empty_like(adj)
    out[order] = np.clip(adj, 0, 1)
    return out


def vif_table(X, names):
    """VIF_j = 1 / (1 - R^2_j) from regressing feature j on the others."""
    X = np.asarray(X, float)
    vals = []
    for j in range(X.shape[1]):
        y, Z = X[:, j], np.delete(X, j, axis=1)
        Z = np.column_stack([np.ones(len(Z)), Z])
        beta, *_ = np.linalg.lstsq(Z, y, rcond=None)
        r2 = 1 - ((y - Z @ beta) ** 2).sum() / ((y - y.mean()) ** 2).sum()
        vals.append(1 / (1 - r2) if r2 < 1 else np.inf)
    return pd.DataFrame({"feature": names, "VIF": vals})


def savefig(name):
    plt.tight_layout()
    plt.savefig(os.path.join(FIG_DIR, name), dpi=150)
    plt.close()


# ---------------------------------------------------------------- 1. QUALITY REPORT
def quality_report(df, name):
    print(f"\n===== {name}: quality report =====")
    print("shape:", df.shape)
    print("exact duplicates:", df.duplicated().sum())
    miss = df.isna().mean().mul(100).round(2)
    print("missing % per column:\n", miss[miss > 0] if (miss > 0).any() else "none")
    print(df.describe(include="all").T.head(15))


# ---------------------------------------------------------------- 2. CLEANING: DATASET A
def clean_crop_production(df):
    log = {"start_rows": len(df)}
    df = df.copy()

    # Step 1: structure and types
    df.columns = [c.strip() for c in df.columns]
    for c in ["State_Name", "District_Name", "Season", "Crop"]:
        df[c] = df[c].astype(str).str.strip()
    df["Crop_Year"] = pd.to_numeric(df["Crop_Year"], errors="coerce")
    df["Area"] = pd.to_numeric(df["Area"], errors="coerce")
    df["Production"] = pd.to_numeric(df["Production"], errors="coerce")

    # Step 2: standardise categories (case + spacing). Review mappings manually afterwards.
    for c in ["State_Name", "District_Name", "Crop"]:
        df[c] = df[c].str.title().str.replace(r"\s+", " ", regex=False)
    df["Season"] = df["Season"].str.title()

    # Step 3: exact duplicates
    before = len(df)
    df = df.drop_duplicates()
    log["duplicates_removed"] = before - len(df)

    # Step 4: missing values (never impute the target)
    log["missing_production"] = int(df["Production"].isna().sum())
    df["production_missing"] = df["Production"].isna()
    df = df.dropna(subset=["Crop_Year", "Area"])

    # Step 5: impossible values
    bad = (df["Area"] <= 0) | (df["Production"] < 0)
    log["invalid_removed"] = int(bad.sum())
    df = df[~bad]

    # Step 6: derived variables
    df["Yield"] = np.where(df["Area"] > 0, df["Production"] / df["Area"], np.nan)
    df["log_area"] = np.log1p(df["Area"])
    df["log_production"] = np.log1p(df["Production"])
    df["Period"] = (df["Crop_Year"] // 5 * 5).astype("Int64")

    # Step 7: outliers - flag (IQR on log-yield WITHIN each crop), do not delete
    ly = np.log1p(df["Yield"])
    grp = ly.groupby(df["Crop"])
    q1, q3 = grp.transform(lambda s: s.quantile(0.25)), grp.transform(lambda s: s.quantile(0.75))
    iqr = q3 - q1
    df["yield_outlier"] = (ly < q1 - 1.5 * iqr) | (ly > q3 + 1.5 * iqr)
    log["outliers_flagged"] = int(df["yield_outlier"].sum())

    log["end_rows"] = len(df)
    print("\nCleaning log (dataset A):", log)
    return df.reset_index(drop=True), log


# ---------------------------------------------------------------- 3. CLEANING: DATASET B
def clean_crop_recommendation(df):
    df = df.copy()
    df.columns = [c.strip() for c in df.columns]
    df["label"] = df["label"].astype(str).str.strip().str.lower()
    n0 = len(df)
    df = df.drop_duplicates()
    # domain range checks
    ok = df["ph"].between(0, 14) & df["humidity"].between(0, 100) & (df["rainfall"] >= 0)
    print(f"\nDataset B: removed {n0 - len(df)} duplicates, {(~ok).sum()} out-of-range rows")
    df = df[ok].reset_index(drop=True)
    print("class balance:\n", df["label"].value_counts().describe()[["min", "max"]])
    return df


# ---------------------------------------------------------------- 4. EDA: DATASET A
def eda_crop_production(df):
    d = df.dropna(subset=["Yield"])
    top_crops = d.groupby("Crop")["Production"].sum().nlargest(6).index.tolist()
    top = d[d["Crop"].isin(top_crops)]

    # Univariate: raw vs log distributions
    fig, ax = plt.subplots(1, 3, figsize=(14, 4))
    for a, col in zip(ax, ["Area", "Production", "Yield"]):
        sns.histplot(np.log1p(d[col]), bins=50, ax=a)
        a.set_title(f"log1p({col})")
    savefig("A_univariate_logs.png")

    # RQ1: trend over time
    trend = top.groupby(["Crop_Year", "Crop"])["Yield"].median().reset_index()
    plt.figure(figsize=(9, 5))
    sns.lineplot(data=trend, x="Crop_Year", y="Yield", hue="Crop", marker="o")
    plt.title("Median district yield by year (top crops)")
    savefig("A_rq1_yield_trend.png")

    # RQ2: regional comparison
    heat = top.pivot_table(index="State_Name", columns="Crop", values="Yield", aggfunc="median")
    plt.figure(figsize=(9, 9))
    sns.heatmap(np.log1p(heat), cmap="YlGn", cbar_kws={"label": "log1p(median yield)"})
    plt.title("Median yield by state and crop")
    savefig("A_rq2_state_crop_heatmap.png")
    cv = d.groupby("Crop")["Yield"].agg(lambda s: s.std() / s.mean() if s.mean() else np.nan)
    print("\nCoefficient of variation of yield by crop (top 10):\n", cv.sort_values(ascending=False).head(10))

    # RQ3: seasonality
    plt.figure(figsize=(10, 5))
    sns.boxplot(data=top, x="Crop", y=np.log1p(top["Yield"]), hue="Season")
    plt.xticks(rotation=30); plt.ylabel("log1p(Yield)")
    savefig("A_rq3_season_boxplot.png")

    # RQ4: area vs production
    s = d.sample(min(20000, len(d)), random_state=SEED)
    plt.figure(figsize=(6, 5))
    sns.scatterplot(data=s, x="log_area", y="log_production", hue="yield_outlier", s=8, alpha=0.5)
    savefig("A_rq4_area_vs_production.png")
    rho, p = stats.spearmanr(d["Area"], d["Production"])
    print(f"\nSpearman Area vs Production: rho={rho:.3f}, p={p:.2e}")

    # Statistical tests ------------------------------------------------------
    # Kruskal-Wallis: yield across seasons, per top crop (with multiple-testing correction)
    rows = []
    for crop in top_crops:
        groups = [g["Yield"].values for _, g in top[top["Crop"] == crop].groupby("Season") if len(g) > 5]
        if len(groups) >= 2:
            h, p = stats.kruskal(*groups)
            rows.append((crop, h, p))
    if rows:
        res = pd.DataFrame(rows, columns=["Crop", "H", "p"])
        res["p_adj_BH"] = bh_adjust(res["p"])
        print("\nKruskal-Wallis (yield ~ season):\n", res.round(4))

    # Mann-Kendall trend per crop (falls back to linear regression slope if package missing)
    try:
        import pymannkendall as mk
        for crop in top_crops:
            ser = top[top["Crop"] == crop].groupby("Crop_Year")["Yield"].median()
            r = mk.original_test(ser.values)
            print(f"Mann-Kendall {crop}: trend={r.trend}, p={r.p:.4f}, slope={r.slope:.4f}")
    except ImportError:
        for crop in top_crops:
            ser = top[top["Crop"] == crop].groupby("Crop_Year")["Yield"].median()
            lr = stats.linregress(ser.index, ser.values)
            print(f"Linear trend {crop}: slope={lr.slope:.4f}, p={lr.pvalue:.4f}")


# ---------------------------------------------------------------- 5. EDA: DATASET B
def eda_crop_recommendation(df):
    feats = ["N", "P", "K", "temperature", "humidity", "ph", "rainfall"]

    # Distributions
    df[feats].hist(bins=30, figsize=(12, 8))
    savefig("B_feature_histograms.png")

    # RQ5: features by crop
    fig, axes = plt.subplots(3, 3, figsize=(16, 12))
    for a, f in zip(axes.ravel(), feats):
        sns.boxplot(data=df, x="label", y=f, ax=a)
        a.tick_params(axis="x", rotation=90); a.set_xlabel("")
    for a in axes.ravel()[len(feats):]:
        a.axis("off")
    savefig("B_rq5_feature_by_crop.png")

    # RQ6: which features separate crops? ANOVA F + eta squared
    out = []
    for f in feats:
        groups = [g[f].values for _, g in df.groupby("label")]
        F, p = stats.f_oneway(*groups)
        grand = df[f].mean()
        ss_b = sum(len(g) * (g.mean() - grand) ** 2 for g in groups)
        ss_t = ((df[f] - grand) ** 2).sum()
        out.append((f, F, p, ss_b / ss_t))
    anova = pd.DataFrame(out, columns=["feature", "F", "p", "eta_sq"]).sort_values("eta_sq", ascending=False)
    print("\nANOVA (feature ~ crop):\n", anova.round(4))

    # RQ7: correlation + VIF
    plt.figure(figsize=(7, 6))
    sns.heatmap(df[feats].corr(method="spearman"), annot=True, fmt=".2f", cmap="coolwarm", center=0)
    savefig("B_rq7_spearman_corr.png")
    X = StandardScaler().fit_transform(df[feats])
    vif = vif_table(X, feats)
    print("\nVIF:\n", vif.round(2))

    # PCA view of crop separation
    pcs = PCA(n_components=2, random_state=SEED).fit_transform(X)
    plt.figure(figsize=(9, 7))
    sns.scatterplot(x=pcs[:, 0], y=pcs[:, 1], hue=df["label"], s=15, legend=False)
    plt.title("PCA of soil and climate features")
    savefig("B_pca.png")


# ---------------------------------------------------------------- MAIN
def main():
    if os.path.exists(RAW_A):
        a_raw = pd.read_csv(RAW_A)
        quality_report(a_raw, "Dataset A (raw)")
        a_clean, _ = clean_crop_production(a_raw)
        a_clean.to_csv(f"{OUT_DIR}/crop_production_clean.csv", index=False)
        eda_crop_production(a_clean)
    else:
        print(f"Missing {RAW_A}; skipping dataset A")

    if os.path.exists(RAW_B):
        b_raw = pd.read_csv(RAW_B)
        quality_report(b_raw, "Dataset B (raw)")
        b_clean = clean_crop_recommendation(b_raw)
        b_clean.to_csv(f"{OUT_DIR}/crop_recommendation_clean.csv", index=False)
        eda_crop_recommendation(b_clean)
    else:
        print(f"Missing {RAW_B}; skipping dataset B")


if __name__ == "__main__":
    main()
